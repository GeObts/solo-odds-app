# Dependencies
node_modules/

# Build output
dist/
*.local
*.tsbuildinfo

# Capacitor native platforms ARE committed so Ionic Appflow can build them
# (Appflow runs `cap sync` against these — it does not run `cap add`).
# Build artifacts inside them are ignored by android/.gitignore and ios/.gitignore.

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
.env
.env.local
